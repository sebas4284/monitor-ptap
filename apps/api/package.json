{
  "name": "@ptap/api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "start:telemetry": "tsx src/main.telemetry.ts",
    "dev:sim": "tsx scripts/dev-sim.ts",
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:mapping": "tsx scripts/generate-mapping.ts && tsx scripts/generate-catalog.ts",
    "generate:catalog": "tsx scripts/generate-catalog.ts",
    "validate:mapping": "tsx scripts/validate-mapping.ts",
    "test:mapping": "node scripts/run-tests.cjs test/opc-mapping.test.ts test/resolve-namespaces.test.ts test/plantas-en-integracion.test.ts",
    "test:bridge": "node scripts/run-tests.cjs test/bridge.test.ts test/frame-coalescer.test.ts test/heartbeat-monitor.test.ts test/connectivity-config.test.ts test/bridge-recovery.test.ts",
    "test:pipeline": "node scripts/run-tests.cjs test/pipeline.test.ts test/rest-cache-latency.test.ts",
    "test:auth": "node scripts/run-tests.cjs test/jwt-auth.guard.test.ts test/rbac-e2e.test.ts test/plant-scope.guard.test.ts test/notifications-scope.test.ts test/login.test.ts",
    "test:push": "node scripts/run-tests.cjs test/push-dispatcher.test.ts test/push-devices.test.ts test/web-push.test.ts test/web-push-api.test.ts",
    "test:diagnostics": "node scripts/run-tests.cjs test/diagnostics.test.ts test/route-check.test.ts test/raw-buffers.test.ts",
    "test:health": "node scripts/run-tests.cjs test/opc-health.test.ts",
    "test:metrics": "node scripts/run-tests.cjs test/metrics.test.ts",
    "test:audit": "node scripts/run-tests.cjs test/audit-log.test.ts test/audit-middleware.test.ts",
    "test:security": "node scripts/run-tests.cjs test/opcua-security-switch.test.ts",
    "test:commands": "node scripts/run-tests.cjs test/command-mapping.test.ts test/write-service.test.ts test/commands-e2e.test.ts",
    "test:sim": "node scripts/run-tests.cjs test/sim-plc.test.ts test/sim-escenarios.test.ts test/sim-controller.test.ts test/sim-valvulas-e2e.test.ts",
    "test:users": "node scripts/run-tests.cjs test/register.test.ts test/users-admin.test.ts test/email-verification.test.ts",
    "test:reports": "node scripts/run-tests.cjs test/reports.test.ts",
    "test:operational": "node scripts/run-tests.cjs test/operational-resilience.test.ts",
    "validate:operational": "tsx scripts/operational-validation.ts",
    "validate:coldstart": "tsx scripts/cold-start.ts",
    "validate:soak-report": "tsx scripts/soak-report.ts",
    "audit:efficiency": "tsx scripts/efficiency-collector.ts",
    "test": "node scripts/run-tests.cjs",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed-admin": "tsx scripts/seed-admin-user.ts",
    "db:seed-users": "tsx scripts/seed-users.ts",
    "db:migrate-users": "tsx scripts/migrate-users.ts",
    "db:credenciales": "tsx scripts/asignar-credenciales.ts",
    "db:disable-demo-users": "tsx scripts/disable-demo-users.ts",
    "test:replay": "node scripts/run-tests.cjs test/plc-replay.test.ts",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/websockets": "^12.3.2",
    "@ptap/shared": "*",
    "ajv": "^8.20.0",
    "argon2": "^0.45.1",
    "compression": "^1.8.2",
    "dotenv": "^18.0.9",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "node-opcua": "^2.187.16",
    "node-opcua-crypto": "^6.2.3",
    "nodemailer": "^10.3.1",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "web-push": "3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "3.6.4",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "ajv": "^8.17.1"
  }
}
