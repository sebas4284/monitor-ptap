# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/
.npm-cache/
/tmp/

# Expo
.expo/
dist/
apps/mobile/dist-audit/
web-build/
expo-env.d.ts
packages/shared/dist/

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
keystore.properties
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
# Respaldos del .env: llevan los MISMOS secretos que el original y el patron `.env` no los
# cubre (solo casa el nombre exacto). El 2026-08-19 un `git add -A` estuvo a punto de subir
# `.env.bak-endpoint-local` con todo dentro. La VM ya acumula varios `.env.bak-*` por el mismo
# motivo -ver docs/PENDIENTES.md-, asi que el patron va aqui antes de que uno acabe en el repo.
.env.bak*
.env.*.bak

# typescript
*.tsbuildinfo

# OPC UA client PKI (auto-generated certificates)
apps/api/pki/
pki/

# Informes CSV generados (archivos de exportación efímeros; no historial).
# OJO: anclar la ruta — un `reports/` suelto también ignoraría src/modules/reports (el código).
apps/api/reports/
/reports/

# generated native folders (expo prebuild) — se regeneran; nunca al repo (incluyen el keystore)
/ios
/android
apps/mobile/ios/
apps/mobile/android/

# Subagent-driven-development scratch state
.superpowers/
apps/mobile/eas.json

# Auditoria local del proyecto: puede mencionar IPs y datos del servidor. No se versiona.
/contexto.md

# Configuración de Firebase de la APK (push FCM). La APK la necesita dentro y se copia a mano antes de
# compilar; no va al repositorio. La CLAVE DE SERVICIO del backend tampoco: esa vive solo en la VM
# (FIREBASE_SERVICE_ACCOUNT_PATH), nunca en este árbol.
apps/mobile/google-services.json

# Material local de trabajo: conservar fuera del historial publico.
/.playwright-mcp/
/cotizacion-aquora-local/
/docs/security-audit/2026-11-02/
/docs/security-audit/2026-11-03/
/docs/superpowers/plans/2026-11-02-pruebas-adversarias-aquora.md
/docs/superpowers/plans/2026-11-02-vm-seguridad-en-sitio.md
/tools/vm/*.decision.json
/tools/vm/web-push-single-test.cjs
/tools/vm/web-push-single-test.test.cjs

# Helpers puntuales ligados a releases y respaldos privados de la VM.
/tools/vm/ptap-autonomy-inspect.cjs
/tools/vm/ptap-autonomy-release.cjs
/tools/vm/ptap-css-js-release.cjs
/tools/vm/ptap-valve-ui-release.cjs
